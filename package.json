{
  "name": "emby-tok",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:add": "cap add android",
    "cap:sync": "cap sync",
    "build:android": "tsc && vite build && cap sync android",
    "release:version": "node -e \"console.log(require('./package.json').version)\"",
    "release:tag": "git tag -a v$(node -e \"console.log(require('./package.json').version)\") -m \"Release v$(node -e \"console.log(require('./package.json').version)\")\"",
    "release:push-tag": "git push origin --tags",
    "release:build-dist": "npm run build && cd dist && zip -r ../dist.zip . && cd ..",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.0.0",
    "framer-motion": "^12.36.0",
    "glob": "^13.0.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtuoso": "^4.18.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.4.35",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^0.19.2"
  }
}
